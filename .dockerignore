# Python
__pycache__
*.py[cod]
*$py.class
*.so
.Python
*.egg-info
dist
build

# Virtual environments
.venv
venv
env
ui/.venv

# IDE
.vscode
.idea
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Git
.git
.gitignore
.github

# Documentation (except docs/)
*.md
!README.md
!docs/**/*.md
!projects/**/README.md

# uv cache
.uv
uv.lock
ui/uv.lock

# Development
.env
.env.local
*.env.local

# Cache and temporary files
ui/data/cache.json
ui/data/indexdir/

# Jupyter checkpoints
.ipynb_checkpoints

# Claude
.claude

# Node — the islands stage runs `npm ci` from the lockfile, so the host's
# node_modules must never enter the build context (slow, platform-specific,
# and would shadow the clean install).
node_modules
ui/components/*/node_modules

# Built island bundles: produced by the islands build stage, not copied from
# the host, so an outdated local build can't ship in the image.
ui/app/static/search
ui/app/static/chat
