KBASE_AUTH_TOKEN=YOUR_AUTH_TOKEN_HERE

# Langfuse tracing (Claude Code sessions → shared cloud project, via the BERIL
# server's relay). No Langfuse keys go here: `beril login` is the credential,
# and the project keypair lives only on the server (BERIL_LANGFUSE_* below).
# Opt-in: `beril setup` asks and writes this flag; leave it unset/false to stay
# off. See docs/langfuse.md.
# TRACE_TO_LANGFUSE=true
# Attribution on every trace; defaults to the ORCiD from `beril login`.
# LANGFUSE_USER_ID=your-pod-account-name

# ORCiD OAuth2 (register at https://orcid.org/developer-tools)
# Use https://sandbox.orcid.org for development/testing
BERIL_ORCID_BASE_URL=https://sandbox.orcid.org
BERIL_ORCID_CLIENT_ID=APP-XXXXXXXXXXXXXXXX
BERIL_ORCID_CLIENT_SECRET=your-orcid-client-secret  # provided by ORCiD
BERIL_ORCID_REDIRECT_ROOT=http://127.0.0.1:8000  # use 127.0.0.1 not localhost — ORCiD blocks localhost
BERIL_ORCID_REDIRECT_PATH=/auth/orcid/callback  # path to the callback route, relative to root

# Auth token providers
# In addition to the ORCiD login, other auth providers can be made available
# These should be listed here, and the names should match those given by modules
# in the ui/app/auth_providers directory
BERIL_AUTH_TOKEN_PROVIDERS=kbase


# Session secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
BERIL_SESSION_SECRET_KEY=change-me-in-production

# PostgreSQL database — run `alembic upgrade head` before first start
# Format: postgresql+asyncpg://DB_USER:DB_PASSWORD@DB_HOST:DB_PORT/DB_NAME
# Alter the below
BERIL_DB_URL=postgresql+asyncpg://beril:beril@localhost:5432/beril
BERIL_DB_HOST=localhost  # change this to the exposed service name in SPIN
BERIL_DB_PORT=5432
BERIL_DB_USER=beril_user
BERIL_DB_PASSWORD=change-in-production
BERIL_DB_NAME=beril

# OpenViking — admin tools only (knowledge_query.py, ingest_context.py's
# interactive modes). Users never set these: `beril context` reaches the
# context layer through BERIL with your `beril login`.
# OPENVIKING_URL=http://127.0.0.1:1933
# OPENVIKING_API_KEY=

# OpenViking config (webapp integration — ui/app/routes/openviking.py)
# OpenViking URL, should be reachable from where this app is deployed.
# Via Rancher, this will be http://name-of-openviking-service:1933
BERIL_OV_URL=http://localhost:1933
# The account namespace set up for BERIL purposes. All users that get accounts through
# here should use this account
BERIL_OV_ACCOUNT_ID=beril
# the credentials of the admin for the given account namespace, needed to set up
# individual user accounts
BERIL_OV_ACCOUNT_ADMIN=beril_admin
BERIL_OV_ADMIN_KEY=change-in-production
# Fernet key used to encrypt stored OpenViking user credentials at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Note that this must be a real Fernet key (even a fake one) for the server to start.
BERIL_OV_CREDENTIAL_KEY=replace-with-valid-fernet-key

# Langfuse relay (webapp — ui/app/routes/langfuse.py). The shared project
# keypair is server-only and never handed to users; the relay validates each
# user's BERIL token and forwards trace writes with these. Unset = relay off.
BERIL_LANGFUSE_PUBLIC_KEY=pk-lf-...
BERIL_LANGFUSE_SECRET_KEY=sk-lf-...
BERIL_LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# Lakehouse archive (webapp — ui/app/clients/archive.py). The copy of every
# submitted project that /submit writes to object storage, read by
# GET /api/context/read when the context store's copy is not byte-exact or the
# path was never ingested (figures). S3-compatible; objects live at
# s3://<bucket>/<prefix>/<project>/<path>. Leave the keys unset and such reads
# answer 502. Defaults shown.
# BERIL_ARCHIVE_ENDPOINT_URL=https://minio.berdl.kbase.us
# BERIL_ARCHIVE_BUCKET=cdm-lake
# BERIL_ARCHIVE_PREFIX=tenant-general-warehouse/microbialdiscoveryforge/projects
BERIL_ARCHIVE_ACCESS_KEY=
BERIL_ARCHIVE_SECRET_KEY=
# BERIL_ARCHIVE_TIMEOUT_SECONDS=20

# Wiki Ask (webapp): the conversational agent over the wiki corpus, run on an
# admin-held key rather than the reader's. Every limit is configuration —
# nothing in the code hard-codes these. Provider names an entry in
# ui/config/chat_providers.yaml; model is one of its models. Quotas count
# tokens (input + output) per calendar day per user and per calendar month
# across all users; max_turns bounds one conversation, max_tool_calls one
# turn's calls to the wiki tool server. Key unset = Ask off. Defaults shown.
# BERIL_WIKI_ASK_PROVIDER=anthropic
# BERIL_WIKI_ASK_MODEL=claude-sonnet-4-6
BERIL_WIKI_ASK_API_KEY=
# BERIL_WIKI_ASK_DAILY_TOKENS_PER_USER=250000
# BERIL_WIKI_ASK_MONTHLY_TOKENS=25000000
# BERIL_WIKI_ASK_MAX_TURNS=20
# BERIL_WIKI_ASK_MAX_TOOL_CALLS=8
